
# Artificial Analysis API key. Needed for LIVE data of Image, Video, Speech and Benchmarks.
# Free key: https://artificialanalysis.ai  (create an account > API key management)
ARTIFICIAL_ANALYSIS_API_KEY=

# Optional: OpenRouter API key. The public model list works without it.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: where to store the SQLite file (default: data/ai_intelligence.db)
AI_MODELS_DB_PATH=
